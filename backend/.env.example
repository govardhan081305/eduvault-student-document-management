# Lambda environment variables (set these in AWS Lambda > Configuration > Environment variables)
BUCKET_NAME=your-s3-bucket-name
TABLE_NAME=student-documents
USERS_TABLE=student-users
# Use a long random string, e.g. generated with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
